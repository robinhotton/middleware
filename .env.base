# =============================================================================
# .env.base — Valeurs communes a tous les environnements (aucun secret)
# Ce fichier est commite. Le .env final est genere par make :
#   make dev   →  cat .env.base .env.dev > .env
#   make prod  →  cat .env.base .env.prod > .env
#
# Secrets requis dans secrets/ (gitignore, jamais commites) :
#   secrets/jwt_private_key.txt      openssl genrsa 2048 > jwt_private_key.pem
#   secrets/jwt_public_key.txt       openssl rsa -in jwt_private_key.pem -pubout > jwt_public_key.pem
#   secrets/admin_password.txt       min 12 car., 1 maj, 1 chiffre, 1 symbole
#   secrets/db_password.txt          prod uniquement
#   secrets/db_readonly_password.txt  python3 -c "import secrets; print(secrets.token_urlsafe(16))"
#   secrets/brevo_smtp_key.txt       cle SMTP Brevo (Settings > SMTP & API > SMTP Keys)
#   secrets/mistral_api_key.txt      https://console.mistral.ai/api-keys/
#   secrets/moodle_admin_token.txt   Moodle > Admin > Plugins > Web services > Tokens
#   secrets/moodle_webhook_secret.txt  python3 -c "import secrets; print(secrets.token_hex(32))"
# =============================================================================

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME="Mon Application"
APP_DESCRIPTION="API REST FastAPI"
APP_VERSION=0.1.0

# ─── Serveur ──────────────────────────────────────────────────────────────────
PORT=8000
API_PREFIX=/api/v1

# ─── Base de donnees ──────────────────────────────────────────────────────────
DB_PORT=5432
DB_USER=myapp
DB_NAME=myapp
# Utilisateur Adminer read-only (SELECT uniquement)
DB_READONLY_USER=viewer

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=RS256
# 8h — journee de travail
JWT_EXPIRATION_MINUTES=480

# ─── Compte admin (cree au demarrage via seed) ────────────────────────────────
ADMIN_EMAIL=pedagogie@diginamic.fr
ADMIN_PSEUDO=Admin

# ─── Mail (commun a tous les envs) ────────────────────────────────────────────
MAIL_FROM=noreply@diginamic.fr
MAIL_FROM_NAME=Diginamic
MAIL_SSL_TLS=False
MAIL_SUPPRESS_SEND=False

# ─── LLM Mistral ──────────────────────────────────────────────────────────────
MISTRAL_MODEL=mistral-small-latest
MISTRAL_MODEL_LIGHT=open-mistral-7b
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MAX_TOKENS=100000
# Nom de l'IA affiche dans les prompts systeme et les interfaces Moodle
AI_NAME=DigilearnIA
# Regles pedagogiques injectees dans le prompt (optionnel, laisser vide pour desactiver)
PLATFORM_POLICIES=
# Limite quotidienne de tokens (prompt + completion) par moodle_userid.
# 0 = desactive. La fenetre se reinitialise a 00:00 UTC.
LLM_DAILY_TOKEN_LIMIT_PER_USER=1000000
# Timeout HTTP du client Mistral en secondes (5-300).
LLM_HTTP_TIMEOUT_SECONDS=60
# Budget max de tokens prompt avant troncature du contexte apprenant.
LLM_MAX_PROMPT_TOKENS=100000

# ─── Moodle ───────────────────────────────────────────────────────────────────
MOODLE_BASE_URL=https://academy.diginamic.fr
MOODLE_SERVICE_NAME=moodle_mobile_app
MOODLE_CACHE_TTL_SECONDS=300

# ─── Securite — anti brute-force ──────────────────────────────────────────────
FAILED_LOGIN_THRESHOLD=5
# Blocages progressifs : 5min / 30min / 2h / definitif
LOCKOUT_DURATIONS_MINUTES=[5,30,120]
EMAIL_VERIFICATION_EXPIRY_MINUTES=10
RESET_TOKEN_EXPIRY_MINUTES=10
TOKEN_BYTES=32
