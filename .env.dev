# =============================================================================
# .env.dev — Surcharges developpement (aucun secret — voir secrets/)
# Generer .env : cat .env.base .env.dev > .env  (ou : make dev / make env-dev)
# =============================================================================

# ─── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=True

# ─── Serveur ──────────────────────────────────────────────────────────────────
# HOST, DB_DRIVER, DB_HOST, LOG_DIR et REDIS_URL sont surcharges par docker-compose.yml en Docker
HOST=127.0.0.1
ALLOWED_ORIGINS=["http://localhost:8000"]

# ─── Base de donnees ──────────────────────────────────────────────────────────
# SQLite en dev local — Docker surcharge DB_DRIVER=postgresql et DB_HOST=postgres
DB_DRIVER=sqlite
DB_HOST=localhost
DB_ECHO=True
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ─── Mail — Mailpit local (UI : http://localhost:8025) ────────────────────────
MAIL_SERVER=localhost
# 1025 = Mailpit ; 587 = STARTTLS ; 465 = SSL/TLS
MAIL_PORT=1025
MAIL_USERNAME=
# Vide : Mailpit ne requiert pas d'authentification
MAIL_PASSWORD=
MAIL_STARTTLS=False
APP_BASE_URL=http://localhost:8000

# ─── Rate limiting — Redis ────────────────────────────────────────────────────
# Vide = stockage in-memory (ok en dev avec WEB_CONCURRENCY=1)
# Docker surcharge avec redis://redis:6379
REDIS_URL=

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG

# ─── OpenAPI — contact (optionnel) ────────────────────────────────────────────
CONTACT_NAME=
CONTACT_URL=
CONTACT_EMAIL=
