# Normalise toutes les fins de ligne en LF dans le depot.
# Chaque checkout restitue LF (pas de conversion CRLF, meme sur Windows).
* text=auto eol=lf

# Fichiers explicitement texte
*.py        text eol=lf
*.pyi       text eol=lf
*.md        text eol=lf
*.toml      text eol=lf
*.cfg       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf
*.ts        text eol=lf
*.sh        text eol=lf
*.sql       text eol=lf
*.txt       text eol=lf
*.env*      text eol=lf
*.conf      text eol=lf
*.ini       text eol=lf
Dockerfile  text eol=lf
Makefile    text eol=lf
LICENSE     text eol=lf

# Fichiers binaires — ne jamais toucher
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
*.zip       binary
*.gz        binary
*.tar       binary
*.pdf       binary
*.sqlite    binary
