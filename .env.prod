# =============================================================================
# .env.prod — Surcharges production (aucun secret — voir secrets/)
# Generer .env : cat .env.base .env.prod > .env  (ou : make prod)
# NE PAS COMMITTER LE .env REMPLI — ce fichier est un template vide
# =============================================================================

# ─── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=False

# ─── Serveur ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
# Nombre de workers Gunicorn (recommande : 2 x CPU + 1)
WEB_CONCURRENCY=4
ALLOWED_ORIGINS=["https://academy.lundimatin.fr"]

# ─── Base de donnees ──────────────────────────────────────────────────────────
DB_DRIVER=postgresql
DB_HOST=postgres
DB_ECHO=False
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ─── Mail — Brevo SMTP ────────────────────────────────────────────────────────
# Autres providers : Gmail (smtp.gmail.com:587), OVH (ssl0.ovh.net:465)
MAIL_SERVER=smtp-relay.brevo.com
# 587 = STARTTLS ; 465 = SSL/TLS
MAIL_PORT=587
MAIL_USERNAME=pedagogie@diginamic.fr
MAIL_STARTTLS=True
APP_BASE_URL=https://middleware.diginamic.fr

# ─── Rate limiting — Redis ────────────────────────────────────────────────────
# Obligatoire en prod avec plusieurs workers Gunicorn
REDIS_URL=redis://redis:6379

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── OpenAPI — contact ────────────────────────────────────────────────────────
CONTACT_NAME=Diginamic
CONTACT_URL=https://diginamic.fr
CONTACT_EMAIL=pedagogie@diginamic.fr
